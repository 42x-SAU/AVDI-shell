# =============================================================================
# AVDI-Shell Environment Configuration
# =============================================================================
# Используйте этот файл как шаблон для создания .env в локальной разработке
# В production используйте управление секретами (secrets management)

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# Хост базы данных
DB_HOST=localhost

# Порт PostgreSQL
DB_PORT=5432

# Пользователь БД
DB_USER=postgres

# Пароль пользователя БД
DB_PASSWORD=postgres

# Имя базы данных
DB_NAME=diag

# Режим SSL для подключения (disable, require, prefer, allow)
DB_SSLMODE=disable

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379
SERVER_ADDR=:8080

WEBSOCKET_ENABLED=true

# =============================================================================
# Task Queue Configuration
# =============================================================================
# Максимальное количество одновременных задач на одного агента
# При превышении лимита новые задачи ставятся в очередь
# Значение по умолчанию: 3
MAX_CONCURRENT_TASKS_PER_AGENT=3

# =============================================================================
# Retry Configuration (for failed tasks)
# =============================================================================
BASE_RETRY_DELAY_SECONDS=30
MAX_RETRY_DELAY_SECONDS=3600

# URL сервера, с которым подключается агент
# Локально: http://localhost:8080
# Docker: http://server:8080
SERVER_URL=http://localhost:8080